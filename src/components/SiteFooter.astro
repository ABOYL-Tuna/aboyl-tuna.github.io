---
import type { Locale } from "../i18n/config";
import { getCompositeBrandName, getSiteCopy } from "../data/site";
import { requireLocalizedPageEntry } from "../utils/content";
import { withBase } from "../utils/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const page = await requireLocalizedPageEntry(locale, "contact");
const footer = page.data.footer;

const phone = footer?.contacts.find((item) => item.kind === "phone");
const email = footer?.contacts.find((item) => item.kind === "email");
const backupEmail = footer?.contacts.find((item) => item.kind === "backupEmail");
const wechat = footer?.contacts.find((item) => item.kind === "wechat");
const github = footer?.contacts.find((item) => item.kind === "github");
const team = footer?.contacts.find((item) => item.kind === "team");
---

<footer class="mx-auto mt-16 max-w-6xl px-5 pb-8 md:mt-24 md:px-8 md:pb-10">
  <div class="paper-panel card-lift surface-mist relative rounded-[2rem] px-5 py-6 md:rounded-[2.2rem] md:px-10 md:py-8">
    <img
      src={withBase("/favicon.jpg")}
      alt={`${getCompositeBrandName(locale)} favicon`}
      class="absolute right-7 top-7 hidden h-20 w-20 rounded-[1.5rem] border border-line bg-white/80 object-cover shadow-[0_14px_30px_rgba(71,78,102,0.1)] md:block"
    />
    <div class="max-w-3xl pr-0 md:pr-28">
      <p class="section-kicker">{footer?.kicker}</p>
      <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <p class="font-display text-2xl text-text md:text-3xl">{copy.name}</p>
        <p class="text-[0.72rem] tracking-[0.22em] text-muted md:text-[0.78rem]">{copy.secondaryName}</p>
      </div>
      <p class="mt-3 text-[0.98rem] leading-7 text-muted md:text-base md:leading-8">{footer?.note}</p>
      <p class="mt-2 text-sm leading-7 text-muted md:text-base">{footer?.tagline}</p>
    </div>

    <div class="mt-7 space-y-4 md:mt-8 md:space-y-5">
      <div class="grid gap-3.5 sm:grid-cols-2 md:gap-4 lg:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_13.5rem_13.5rem]">
        {phone && (
          <div class="footer-meta-row flex min-w-0 items-start gap-3 rounded-[1.4rem] border border-line bg-white/72 px-4 py-4 sm:items-center md:gap-4 md:rounded-[1.55rem]">
            <span class="footer-icon-badge flex h-11 w-11 items-center justify-center rounded-full border border-line bg-white/80 text-accent-deep">
              <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6.8 4.8h2.8l1 3.5-1.8 1.6a14.4 14.4 0 0 0 6.6 6.6l1.6-1.8 3.5 1v2.8c0 .7-.5 1.2-1.2 1.2A16.3 16.3 0 0 1 5.6 6c0-.7.5-1.2 1.2-1.2Z" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="section-kicker block !text-[0.72rem] !tracking-[0.2em]">{phone.label}</span>
              <span class="mt-1 block break-words text-lg text-text md:text-[1.35rem]">{phone.value}</span>
            </span>
          </div>
        )}

        {email && (
          <div class="footer-meta-row flex min-w-0 items-start gap-3 rounded-[1.4rem] border border-line bg-white/72 px-4 py-4 sm:items-center md:gap-4 md:rounded-[1.55rem]">
            <span class="footer-icon-badge flex h-11 w-11 items-center justify-center rounded-full border border-line bg-white/80 text-accent-deep">
              <svg viewBox="0 0 24 24" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4.5 6.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Zm0 1.4 7.5 5.1 7.5-5.1" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="section-kicker block !text-[0.72rem] !tracking-[0.2em]">{email.label}</span>
              <a href={email.href} class="mt-1 block break-all text-base text-text transition-colors hover:text-accent-deep md:text-[1.05rem]">
                {email.value}
              </a>
              {backupEmail && (
                <span class="mt-2 block border-t border-line pt-2">
                  <span class="block text-[0.68rem] tracking-[0.14em] text-muted">{backupEmail.label}</span>
                  <a href={backupEmail.href} class="mt-0.5 block break-all text-sm text-muted transition-colors hover:text-accent-deep">
                    {backupEmail.value}
                  </a>
                </span>
              )}
            </span>
          </div>
        )}

        {github?.href && (
          <a
            href={github.href}
            target="_blank"
            rel="noreferrer"
            class="footer-social-card group flex min-w-0 flex-col items-center justify-center rounded-[1.4rem] border border-line bg-white/72 px-4 py-4 text-center hover:border-line-strong md:rounded-[1.55rem] md:px-5 md:py-5"
          >
            <span class="footer-icon-badge flex h-14 w-14 items-center justify-center rounded-full border border-line bg-white/82 text-accent-deep transition-transform duration-200 group-hover:scale-105">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
                <path d="M12 3.9c-4.5 0-8.1 3.6-8.1 8.1 0 3.6 2.3 6.6 5.5 7.7.4.1.5-.2.5-.4v-1.6c-2.2.5-2.7-.9-2.7-.9-.4-1-.9-1.2-.9-1.2-.7-.5 0-.5 0-.5.8 0 1.2.8 1.2.8.7 1.2 1.9.8 2.3.7.1-.5.3-.8.5-1-1.8-.2-3.7-.9-3.7-4 0-.9.3-1.6.8-2.2-.1-.2-.4-1 .1-2.2 0 0 .7-.2 2.3.8a7.8 7.8 0 0 1 4.2 0c1.6-1 2.3-.8 2.3-.8.5 1.2.2 2 .1 2.2.5.6.8 1.3.8 2.2 0 3.1-1.9 3.8-3.7 4 .3.3.6.8.6 1.6v2.3c0 .2.1.5.5.4 3.2-1.1 5.5-4.1 5.5-7.7 0-4.5-3.6-8.1-8.1-8.1Z" />
              </svg>
            </span>
            <span class="mt-4 section-kicker !text-[0.72rem] !tracking-[0.2em]">{github.label}</span>
            <span class="mt-1 break-words text-base text-text">{github.value}</span>
          </a>
        )}

        {team?.href && (
          <a
            href={team.href}
            target="_blank"
            rel="noreferrer"
            class="footer-social-card group flex min-w-0 flex-col items-center justify-center rounded-[1.4rem] border border-line bg-white/72 px-4 py-4 text-center hover:border-line-strong md:rounded-[1.55rem] md:px-5 md:py-5"
          >
            <span class="footer-icon-badge flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border border-line bg-white/82 transition-transform duration-200 group-hover:scale-105">
              {team.imageSrc ? (
                <img src={withBase(team.imageSrc)} alt={team.imageAlt ?? team.label} class="h-full w-full object-cover" />
              ) : (
                <span class="text-accent-deep">AIS</span>
              )}
            </span>
            <span class="mt-4 section-kicker !text-[0.72rem] !tracking-[0.2em]">{team.label}</span>
            <span class="mt-1 break-words text-base text-text">{team.value}</span>
          </a>
        )}
      </div>

      {wechat && (
        <div class="rounded-[1.55rem] border border-line bg-white/72 px-4 py-4 md:rounded-[1.8rem] md:px-5 md:py-5">
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-5">
            {wechat.imageSrc && (
              <img
                src={withBase(wechat.imageSrc)}
                alt={wechat.imageAlt ?? wechat.label}
                class="mx-auto h-32 w-32 rounded-[1.2rem] border border-line object-cover md:mx-0 md:h-36 md:w-36 md:rounded-[1.35rem]"
              />
            )}
            <div class="max-w-2xl">
              <p class="section-kicker !text-[0.72rem] !tracking-[0.2em]">{wechat.label}</p>
              <p class="mt-2 font-display text-[2rem] text-text md:text-[2.2rem]">{wechat.value}</p>
              <p class="mt-3 text-sm leading-7 text-muted md:text-base">
                {locale === "zh"
                  ? "可扫描二维码添加，也可直接通过微信号联系。"
                  : "Scan the QR code or use the WeChat ID directly."}
              </p>
            </div>
          </div>
        </div>
      )}
  </div>
</footer>
